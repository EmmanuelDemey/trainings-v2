# Copies of ../tanstack-query-common (the fake API, the Network panel and the
# shared specs), written into every workshop and solution by
# `pnpm run sync` — which `pnpm install` and `pnpm run build` run. The single
# source stays in tanstack-query-common/.
workshops/*/src/api/
solutions/*/src/api/
workshops/*/src/tests/shared/
solutions/*/src/tests/shared/
