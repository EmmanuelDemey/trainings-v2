{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable", "esnext.disposable"],
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  // The type tests are graded by `npm test` (Vitest's typecheck mode, with
  // tsconfig.typetests.json), not by `npm run typecheck`: on the starter they
  // are SUPPOSED to hold type errors — that is what makes them red.
  "exclude": ["src/**/*.test-d.ts"]
}
