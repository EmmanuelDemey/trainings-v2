# Build-time defaults, baked into the bundle by `vite build`. Committed: there is
# nothing secret here — and there must never be, since every VITE_ variable ends
# up in plain text in dist/assets/*.js.
#
# A container started with API_BASE_URL / APP_ENVIRONMENT overrides them at
# RUNTIME, through /env.js — without rebuilding the image.
VITE_API_BASE_URL=http://localhost:5173/api
VITE_APP_ENVIRONMENT=development
