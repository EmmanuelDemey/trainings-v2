{
  "name": "tp-08-production",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:staging": "vue-tsc --noEmit && vite build --mode staging",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "analyze": "ANALYZE=1 vite build",
    "size": "size-limit",
    "serve:local": "docker compose -f docker/compose.yml up -d",
    "serve:local:stop": "docker compose -f docker/compose.yml down",
    "verify:serving": "bash docker/verify-serving.sh"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@size-limit/file": "^11.1.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "size-limit": "^11.1.6",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
