{
  "name": "tp-08-production",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:staging": "vue-tsc --noEmit && vite build --mode staging",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "analyze": "ANALYZE=1 vite build",
    "size": "size-limit",
    "serve:local": "docker compose -f docker/compose.yml up -d",
    "serve:local:stop": "docker compose -f docker/compose.yml down",
    "verify:serving": "bash docker/verify-serving.sh"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@size-limit/file": "^13.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^13.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.10"
  }
}
