    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.10"
  }
}
