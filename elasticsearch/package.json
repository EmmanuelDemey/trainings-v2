{
  "name": "elasticsearch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.1",
  "scripts": {
    "sync": "node ../elasticsearch-common/scripts/sync.mjs",
    "postinstall": "node ../elasticsearch-common/scripts/sync.mjs",
    "list": "training-kit list",
    "dev": "node ../elasticsearch-common/scripts/sync.mjs && training-kit dev",
    "slides": "node ../elasticsearch-common/scripts/sync.mjs && training-kit slides",
    "site": "training-kit site",
    "build": "node ../elasticsearch-common/scripts/sync.mjs && training-kit build",
    "build:fast": "node ../elasticsearch-common/scripts/sync.mjs && training-kit build --no-pdf",
    "check": "training-kit check"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.8",
    "@emmanueldemey/training-kit": "^0.1.0",
    "@slidev/cli": "53.1.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "astro": "^7.4.4",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
