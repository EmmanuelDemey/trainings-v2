{
  "name": "trainings-v2",
  "private": true,
  "type": "module",
  "description": "Builds the workshops site and the slide decks into a single build/ folder",
  "packageManager": "pnpm@12.3.1",
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:site": "node scripts/build-all.mjs --only site",
    "build:slides": "node scripts/build-all.mjs --only slides",
    "preview": "pnpm dlx serve build"
  },
  "dependencies": {
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@netlify/plugin-lighthouse": "^6.0.4",
    "netlify-plugin-checklinks": "^4.1.1"
  }
}
