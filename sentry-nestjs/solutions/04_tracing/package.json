{
  "name": "sentry-nestjs-04-tracing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start --exec \"node --env-file-if-exists=.env --import ./dist/instrument.js\"",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env --enable-source-maps --import ./dist/instrument.js\"",
    "start:prod": "node --enable-source-maps --import ./dist/instrument.js dist/main.js",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject ./dist && sentry-cli sourcemaps upload --release \"$SENTRY_RELEASE\" ./dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@sentry/nestjs": "^11.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.3",
    "@sentry/cli": "^3.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "~7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@swc/core": false,
    "@sentry/cli": true
  }
}
