# Copy to .env — `npm run start:dev` reads it (node --env-file-if-exists=.env).
# Never commit .env: it is gitignored.

# Optional: a real project of sentry.io. Empty: the SDK sends nothing to Sentry.
SENTRY_DSN=

# Spotlight, Sentry for development: `npx @spotlightjs/spotlight` in another terminal,
# then http://localhost:8969. `1`, or the sidecar's URL.
SENTRY_SPOTLIGHT=1

NODE_ENV=development

# Chapter 03 — the release this build is, and the upload of its source maps.
SENTRY_RELEASE=issue-tracker-api@1.0.0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
